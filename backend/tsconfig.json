{
  "compilerOptions": {
    // Указываем версию ECMAScript для компиляции
    "target": "ES2022",

    // Модульная система для Node.js
    "module": "commonjs",

    // Библиотеки для использования
    "lib": ["ES2022"],

    // Директория для скомпилированных файлов
    "outDir": "./dist",

    // Корневая директория исходных файлов
    "rootDir": "./src",

    // Включить строгую проверку типов
    "strict": true,

    // Разрешить использование модулей ES6 вместе с CommonJS
    "esModuleInterop": true,

    // Пропускать проверку типов в библиотеках
    "skipLibCheck": true,

    // Обеспечить совместимость регистра имен файлов
    "forceConsistentCasingInFileNames": true,

    // Разрешить использование экспериментальных декораторов
    "experimentalDecorators": true,

    // Генерировать метаданные для декораторов
    "emitDecoratorMetadata": true,

    // Разрешить использование JSON модулей
    "resolveJsonModule": true,

    // Генерировать source maps для отладки
    "sourceMap": true,

    // Удалять комментарии при компиляции
    "removeComments": true,

    // Не генерировать файлы при ошибках компиляции
    "noEmitOnError": true,

    // Включить строгую проверку null и undefined
    "strictNullChecks": true,

    // Включить строгую проверку свойств функций
    "strictFunctionTypes": true,

    // Включить строгую проверку bind, call и apply
    "strictBindCallApply": true,

    // Включить строгую проверку свойств классов
    "strictPropertyInitialization": true,

    // Запретить неявный any
    "noImplicitAny": true,

    // Запретить неявный this
    "noImplicitThis": true,

    // Запретить неявный возврат
    "noImplicitReturns": true,

    // Запретить недостижимый код
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Настройки путей для импортов
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@models/*": ["src/models/*"],
      "@controllers/*": ["src/controllers/*"],
      "@services/*": ["src/services/*"],
      "@middleware/*": ["src/middleware/*"],
      "@utils/*": ["src/utils/*"],
      "@config/*": ["src/config/*"]
    }
  },

  // Включаемые файлы
  "include": [
    "src/**/*"
  ],

  // Исключаемые файлы
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}

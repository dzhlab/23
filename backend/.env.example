# Файл примера переменных окружения для backend
# Скопируйте этот файл в .env и заполните реальными значениями

# Порт, на котором будет запущен сервер
PORT=3000

# Режим работы приложения (development, production, test)
NODE_ENV=development

# URL подключения к базе данных PostgreSQL
# Формат: postgresql://пользователь:пароль@хост:порт/база_данных
DATABASE_URL=postgresql://postgres:password@localhost:5432/gymnastics_db

# Хост базы данных
DB_HOST=localhost

# Порт базы данных PostgreSQL
DB_PORT=5432

# Имя пользователя базы данных
DB_USER=postgres

# Пароль пользователя базы данных
DB_PASSWORD=password

# Название базы данных
DB_NAME=gymnastics_db

# Секретный ключ для подписи JWT токенов (генерируйте случайную строку)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Время жизни access токена (например: 15m, 1h, 1d)
JWT_ACCESS_TOKEN_EXPIRY=1h

# Время жизни refresh токена
JWT_REFRESH_TOKEN_EXPIRY=7d

# URL подключения к Redis для кеширования
# Формат: redis://хост:порт
REDIS_URL=redis://localhost:6379

# Хост Redis
REDIS_HOST=localhost

# Порт Redis
REDIS_PORT=6379

# Пароль Redis (если установлен)
REDIS_PASSWORD=

# База данных Redis (0-15)
REDIS_DB=0

# CORS - разрешенные источники (через запятую)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Максимальный размер загружаемых файлов (в байтах)
# 10MB = 10485760 байт
MAX_FILE_SIZE=10485760

# Лимит запросов в минуту для rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Настройки логирования
# Уровень логов (error, warn, info, debug)
LOG_LEVEL=debug

# Директория для хранения логов
LOG_DIR=./logs

# Настройки сессий
SESSION_SECRET=your-session-secret-change-this

# Время жизни сессии (в миллисекундах)
SESSION_MAX_AGE=86400000

# Настройки email (для уведомлений)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# URL frontend приложения (для ссылок в письмах)
FRONTEND_URL=http://localhost:5173

# Включить облачную синхронизацию (true/false)
CLOUD_SYNC_ENABLED=false

# URL API облачного сервиса
CLOUD_SYNC_URL=https://api.example.com

# Токен для облачной синхронизации
CLOUD_SYNC_TOKEN=

# Интервал синхронизации с облаком (в миллисекундах)
# 60000 = 1 минута
CLOUD_SYNC_INTERVAL=60000

# Директория для резервных копий
BACKUP_DIR=./backups

# Автоматическое резервное копирование (true/false)
AUTO_BACKUP_ENABLED=true

# Интервал автоматического резервного копирования (в секундах)
# 3600 = 1 час
AUTO_BACKUP_INTERVAL=3600

# Путь к SSL сертификатам (если используется HTTPS)
SSL_KEY_PATH=
SSL_CERT_PATH=

# Включить Swagger документацию API (true/false)
ENABLE_SWAGGER=true

# Порт для WebSocket сервера
WEBSOCKET_PORT=3001

# Включить CORS для WebSocket (true/false)
WEBSOCKET_CORS_ENABLED=true
